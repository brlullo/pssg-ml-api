{
  "display_name": "Complication Risk — Halo-Gravity Traction (HGT)",
  "description": "Predicts 2-year probability of implant-related complication in early-onset scoliosis (EOS) patients undergoing growing rod treatment, comparing risk with vs. without preoperative halo-gravity traction",
  "version": "1.0.0",
  "algorithm": "Proportional-odds ordinal logistic regression with restricted cubic splines",
  "framework": "R rms (exported to JSON, scored in Python)",
  "prediction_type": "scenario_comparison",
  "features": [
    {
      "name": "coronal_deformity",
      "type": "continuous",
      "description": "Baseline maximum scoliosis (coronal) curve in degrees [0-140]",
      "example_value": 70.0
    },
    {
      "name": "max_kyphosis",
      "type": "continuous",
      "description": "Baseline maximum kyphosis in degrees [40-180]; the model uses kyphosis in excess of 45°",
      "example_value": 52.0
    },
    {
      "name": "age_years",
      "type": "continuous",
      "description": "Age at index surgery in years",
      "example_value": 6.5
    },
    {
      "name": "gender",
      "type": "categorical",
      "description": "Patient gender",
      "options": ["Male", "Female"]
    },
    {
      "name": "race",
      "type": "categorical",
      "description": "Patient race",
      "options": ["White", "Black", "Other"]
    },
    {
      "name": "weight_kg",
      "type": "continuous",
      "description": "Patient weight in kilograms",
      "example_value": 18.3
    },
    {
      "name": "etiology",
      "type": "categorical",
      "description": "EOS etiology",
      "options": ["Congenital", "Idiopathic", "Neuromuscular", "Syndromic/Other"]
    },
    {
      "name": "ambulatory_status",
      "type": "categorical",
      "description": "Ambulatory status at baseline",
      "options": ["Ambulatory", "Non-Ambulatory", "Therapeutic"]
    },
    {
      "name": "pelvic_attachments",
      "type": "categorical",
      "description": "Pelvic attachments used",
      "options": ["No", "Yes"]
    },
    {
      "name": "rod_number",
      "type": "categorical",
      "description": "Rod configuration",
      "options": ["Unilateral", "Bilateral"]
    },
    {
      "name": "device_type",
      "type": "categorical",
      "description": "Growth-friendly device type",
      "options": ["VEPTR/TGR", "MCGR"]
    }
  ],
  "ui": {
    "groups": [
      {
        "title": "",
        "fields": [
          {"label": "Age (years) [0-18]", "control": "number", "feature": "age_years"},
          {"label": "Gender", "control": "select", "options": [
            {"label": "Male", "set": {"gender": "Male"}},
            {"label": "Female", "set": {"gender": "Female"}}
          ]},
          {"label": "Race", "control": "select", "options": [
            {"label": "White", "set": {"race": "White"}},
            {"label": "Black", "set": {"race": "Black"}},
            {"label": "Other", "set": {"race": "Other"}}
          ]},
          {"label": "Weight (kg)", "control": "number", "feature": "weight_kg"},
          {"label": "Etiology", "control": "select", "options": [
            {"label": "Idiopathic", "set": {"etiology": "Idiopathic"}},
            {"label": "Congenital", "set": {"etiology": "Congenital"}},
            {"label": "Neuromuscular", "set": {"etiology": "Neuromuscular"}},
            {"label": "Syndromic/Other", "set": {"etiology": "Syndromic/Other"}}
          ]},
          {"label": "Ambulatory Status", "control": "select", "options": [
            {"label": "Ambulatory", "set": {"ambulatory_status": "Ambulatory"}},
            {"label": "Non-Ambulatory", "set": {"ambulatory_status": "Non-Ambulatory"}},
            {"label": "Therapeutic Ambulator", "set": {"ambulatory_status": "Therapeutic"}}
          ]},
          {"label": "Pelvic Attachments", "control": "select", "options": [
            {"label": "Yes", "set": {"pelvic_attachments": "Yes"}},
            {"label": "No", "set": {"pelvic_attachments": "No"}, "default": true}
          ]},
          {"label": "Device Type", "control": "select", "options": [
            {"label": "VEPTR/TGR", "set": {"device_type": "VEPTR/TGR"}},
            {"label": "MCGR", "set": {"device_type": "MCGR"}}
          ]},
          {"label": "Rod Number", "control": "select", "options": [
            {"label": "Unilateral", "set": {"rod_number": "Unilateral"}},
            {"label": "Bilateral", "set": {"rod_number": "Bilateral"}}
          ]},
          {"label": "Baseline Max Scoliosis (degrees) [0-140]", "control": "number", "feature": "coronal_deformity"},
          {"label": "Baseline Max Kyphosis (degrees) [40-180]", "control": "number", "feature": "max_kyphosis"}
        ]
      }
    ],
    "level_labels": {"1+": "1+ UPRORs", "2+": "2+ UPRORs", "3+": "3+ UPRORs"},
    "result_note": "Presented are predicted probabilities of UPROR (unplanned return to operating room due to implant complication) within 2 years, with 95% confidence intervals. For the difference column, values below 0 represent reduced probability of UPROR with preoperative halo-gravity traction (>7 days). Reference: Paulson A, Nian H, Martus J, Smith J, Sponseller P, Emans J, Welborn M, PSSG, Louer C. SRS Annual Meeting, 2024."
  },
  "metrics": {
    "c_statistic": 0.7044
  },
  "cohort": {
    "total_patients": 1606
  },
  "last_updated": "2026-08-10",
  "limitations": "Developed by VUMC Biostatistics from the PSSG database (n=1,606, multiple imputation for missing data). Reports probability of ANY implant-related complication at a fixed 2-year (730-day) horizon; the underlying ordinal model also distinguishes severity levels not exposed here. Both treatment scenarios (with and without preoperative halo-gravity traction) are returned per request with 95% confidence intervals. C-statistic 0.70 indicates moderate discrimination. Hosted with the authors' permission; reference implementation: https://vumcbiostat.shinyapps.io/hgtmodel/"
}
